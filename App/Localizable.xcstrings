    "Advanced integrations need the last bit of setup from you. ElevenLabs and OpenAI's niche engines just need a key on the Engine tab; Ollama and custom endpoints run a model on your own machine.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Avancerede integrationer kræver det sidste stykke opsætning fra dig. ElevenLabs og OpenAIs nichemotorer skal bare bruge en nøgle under fanen Motor; Ollama og brugerdefinerede endpoints kører en model på din egen maskine."
          }
        }
      }
    },
