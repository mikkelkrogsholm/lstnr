      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bærbar / rummikrofon"
          }
        }
      }
    },
    "Tunes OpenAI Realtime's input noise reduction. Pick the option that matches how close you speak to the mic.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Justerer OpenAI Realtimes støjreduktion på input-lyden. Vælg det der passer til hvor tæt du taler på mikrofonen."
          }
        }
      }
    },
    "All engines": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle motorer"
          }
        }
      }
    },
    "Language and vocabulary apply to every engine. Vocabulary biases the transcript toward names/jargon/spellings you set (used by Groq, OpenAI GPT-4o Transcribe, ElevenLabs).": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprog og ordforråd gælder alle motorer. Ordforrådet biaser transskriptionen mod de navne/fagudtryk/stavemåder du angiver (bruges af Groq, OpenAI GPT-4o Transcribe, ElevenLabs)."
          }
        }
      }
    },
