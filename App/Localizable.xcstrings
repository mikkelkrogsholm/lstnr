    "Accessibility lets Vara see the dictation key everywhere and paste the text where your cursor is. Without it, nothing works globally.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilgængelighed lader Vara se dikteringstasten overalt og indsætte teksten dér, hvor din markør står. Uden den virker intet globalt."
          }
        }
      }
    },
